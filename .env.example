# .env — settings for Agent Reels. Copy to .env and fill in. Lines starting with # are notes.
# After changing this file: pm2 restart generator --update-env

# ---- Required ----
PUBLIC_URL=https://yourdomain.com          # your site's public https address (no trailing slash)
PRODUCT_NAME=Agent Reels
OPENAI_API_KEY=
PIXABAY_API_KEY=
# PORT=3100
# HOST=127.0.0.1

# ---- Plans and Stripe (leave the Stripe keys empty to turn billing off) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# STRIPE_PRICE_STARTER_YEARLY=                # optional yearly prices (e.g. 10× the monthly = 2 months free); SETUP.md section W
# STRIPE_PRICE_PRO_YEARLY=
PLAN_STARTER_NAME=Solo
PLAN_STARTER_VIDEOS=30
PLAN_STARTER_ABOUT=You run it: guided setup, the coach, overnight videos and Instagram posting.
PLAN_PRO_NAME=Done for you
PLAN_PRO_VIDEOS=60
PLAN_PRO_ABOUT=We tune your content and prompts for you. You just watch and approve.
MANAGED_PLAN=pro                           # workspaces on this plan count as "done for you"
TRIAL_DAYS=0
COMP_VIDEOS=30                             # videos a month for comped workspaces (and everyone when billing is off)

# ---- Terms of Service and Privacy Policy (optional; see SETUP.md section K) ----
# Both links set = agents must accept before using the app. Change TERMS_VERSION to ask everyone again.
TERMS_URL=
PRIVACY_URL=
TERMS_VERSION=1

# ---- Two-factor login and sessions (optional; see SETUP.md section O) ----
# TWO_FACTOR=admins                        # admins (default) | all | off
# APP_KEY=                                 # encrypts 2FA keys; empty = a random key in .app-key (keep a copy of it)
# AUDIT_KEEP_MONTHS=24                     # how long the activity log is kept
# ACCESS_KEEP_DAYS=180                     # handled access requests (landing page) are removed after this
# ADMIN_SESSION_DAYS=7                     # admins log in again after this many days
# SESSION_IDLE_DAYS=14                     # any session ends after this many days unused

# ---- Off-site encrypted backups (optional but recommended; see SETUP.md section Q) ----
# BACKUP_KEY: openssl rand -hex 32. Save it in your password manager: without it nobody can read the backups.
BACKUP_KEY=
BACKUP_S3_ENDPOINT=                        # e.g. https://s3.us-west-004.backblazeb2.com
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=                          # e.g. us-west-004 (Cloudflare R2: auto)
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=agent-reels/
# BACKUP_S3_KEEP_DAYS=30

# ---- Data deletion page (see SETUP.md section M) ----
# Shown on /data-deletion as where to write when someone can't log in.
SUPPORT_EMAIL=

# ---- Alerts on your phone (optional) ----
# An ntfy.sh topic (free app), or a Slack / Discord webhook URL.
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_FORMAT=                    # text | slack | discord | json (picked automatically)
LOW_DISK_GB=3
# LIBRARY_MAX_CLIPS=40                     # agents' own clips (Brand), per workspace
# CLIP_UPLOAD_MAX_MB=200                   # largest clip upload; nginx client_max_body_size must allow it
# HEALTH_TOKEN=                            # openssl rand -hex 16; /api/health?token=… shows details (SETUP.md section R)
# BACKUP_LATE_HOURS=36                     # alert and fail the health check when the backup is this late
# JOB_STUCK_MINUTES=30                     # a video rendering longer than this counts as stuck
# ERROR_BURST=5                            # this many unexpected errors in 10 minutes sends an alert

# ---- Instagram auto-posting (optional; see SETUP.md section F) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TOKEN_KEY=                                 # openssl rand -hex 32  (never change it once agents connect)
# INSTAGRAM_API_VERSION=v25.0
# INSTAGRAM_INSIGHTS=1                      # fill in views/reach automatically (needs the insights permission; SETUP.md section W)
# INSTAGRAM_REPLIES=1                       # keyword replies to comments and messages (needs the messages permissions; SETUP.md section AS)
# INSTAGRAM_WEBHOOK_TOKEN=                 # the verify token you typed in Meta app → Instagram → Webhooks (section AS)

# ---- Facebook Page cross-posting (optional; see SETUP.md section AC) ----
# FACEBOOK_APP_ID=                         # the Meta app's App ID (Facebook Login for Business)
# FACEBOOK_APP_SECRET=
# FACEBOOK_API_VERSION=v25.0

# ---- AI models and limits (optional; SETUP.md section X) ----
# OPENAI_MODEL=                            # writes scripts and post text (default gpt-4o)
# OPENAI_HOOK_MODEL=                       # writes the openings (default: OPENAI_MODEL)
# OPENAI_CRITIC_MODEL=                     # ranks openings and drafts; best as a different model (default: OPENAI_MODEL)
# OPENAI_STRUCTURED=on                     # exact reply shapes (structured outputs); off for providers that don't support them
# OVERNIGHT_DRAFTS=1                       # drafts per overnight video (1-3); videos made by hand use the agent's setting
# VOICE_TAKE=single                        # single = one recording per video, cut into scenes (default); scene = one per scene
# OPENAI_TRANSCRIBE_MODEL=whisper-1        # word timings for single-take cuts and captions (must support word timestamps)

# ---- Footage (optional; SETUP.md section Y) ----
# PEXELS_API_KEY=                          # free at pexels.com/api: a second stock source, mixed with Pixabay
# SHARED_CLIP_DAYS=120                     # a stock clip any agent used this recently is avoided for the others; 0 = off
# OPENAI_QUICK_MODEL=
# OPENAI_COACH_MODEL=
# OPENAI_VISION_MODEL=
# OPENAI_TTS_MODEL=
# COACH_PER_DAY=60                         # coach answers per workspace per day
AI_COST_CAP_USD=20                         # monthly AI cost cap per workspace (USD); 0 = no cap. Alert at 80%, paused at 100%. Per-workspace override in Admin.
# SCRIPT_TESTS_PER_DAY=                    # test scripts per workspace per day

# ---- Clean-up (days) ----
# KEEP_REJECTED_DAYS=14
# KEEP_PENDING_DAYS=30
# KEEP_VIDEO_FILES_DAYS=90
# KEEP_ASSETS_DAYS=30
# KEEP_BACKUPS=14

# Notifications (Web Push). Optional: the server makes and keeps its own key pair in data/ the first
# time it's needed. Set these (base64url) only to keep the same key across servers.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Outages: a video whose AI or footage calls fail because the service is down waits this many minutes
# and tries again (up to 6 times) instead of failing.
# OUTAGE_WAIT_MIN=10

# Assistant seats (a paid add-on): a recurring per-seat Stripe price. Without it, you give seats in Admin.
# STRIPE_PRICE_SEAT=price_...
# The same seat, billed yearly (for agents on yearly plans).
# STRIPE_PRICE_SEAT_YEARLY=price_...

# ---- v15: backup AI companies and model ladders (optional but recommended; SETUP.md section AK) ----
# OpenAI is removing the models this app used by default: speech (gpt-4o-mini-tts, tts-1) on 2027-01-06,
# gpt-4o / gpt-4o-mini / gpt-4.1 on 2027-01-14, whisper-1 on 2027-02-26. Each job steps down its
# ladder by itself when a model is retired; a second company keeps videos coming during an OpenAI outage.
# ANTHROPIC_API_KEY=                       # Claude as the backup for writing, the coach and footage checks
# ELEVENLABS_API_KEY=                      # ElevenLabs as the backup voice (it also times its own words)
# ELEVENLABS_VOICE_ID=                     # the ElevenLabs voice to use (from your ElevenLabs voice library)
# ELEVENLABS_VOICES={"coral":"<voice id>"} # optional: one ElevenLabs voice for each Brand voice
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_PRICE_PER_1K_CHARS=0.30       # for the cost meter: what your ElevenLabs plan charges
# A whole ladder for one job (first choice first; "anthropic:" or "elevenlabs:" for the other companies).
# Jobs: WRITER HOOKS CRITIC COACH QUICK VISION VOICE TIMING. See them with: node admin.js models
# AI_LADDER_WRITER=gpt-6-luna,anthropic:claude-sonnet-5-5
# AI_LADDER_VOICE=gpt-4o-mini-tts,elevenlabs:eleven_multilingual_v2

# ---- v15: the watchdog (stuck videos are stopped and tried again) ----
# JOB_IDLE_MINUTES=12                      # a video with no progress for this long is stopped
# JOB_MAX_MINUTES=40                       # no video runs longer than this
# RENDER_TIMEOUT_MIN=                      # the render's own limit (default: 10 seconds per second of video, at least 5 minutes)

# ---- v15: data safety and the video line (SETUP.md section AL) ----
# STAY_ON_JSON=1                           # keep using JSON files (the database is the standard from 15)
# DISK_RESERVE_GB=1.5                      # below this much free space, no new video starts (logins and approvals can always be saved)
# WORKER_JOBS=1                            # videos one worker makes at once (renders use every CPU)
# LEASE_SECONDS=90                         # a video whose worker stops renewing its lease this long goes back in line

# ---- v15: breakers (SETUP.md section AM) ----
# BREAKER_FAILURES=5                       # failures in a row (the service down, not a refused request) that open a service's breaker
# BREAKER_COOL_SECONDS=60                  # how long it stays open before one trial call (doubles each time, up to 15 minutes)
# LIMP_AFTER_TRIES=3                       # tries the voice (or footage) service may fail before a video is made without it

# ---- v15: gauges, the clock check and the reference render (SETUP.md section AN) ----
# OPENAI_TIMEOUT_MS=90000                  # how long to wait for one OpenAI answer (the default suits every job)
# FAULTS_ALLOWED=0                         # 1 only on a spare server, to rehearse the crash and fault tests there

# ---- v15: aging well (SETUP.md section AO) ----
# APP_KEY_OLD=                             # with APP_KEY: earlier keys, comma-separated, so what they sealed still opens (node admin.js rotate-key)
# FONT_SOURCE_URL=                         # where a missing font is fetched (default: Google Fonts at the tested version); always checked
# REHEARSAL_PORT=3199                      # update.sh tries a new version here on a copy of your data before it goes live
# VIDEO_CACHE_FILES=300                    # how many video lists (current and archived) are kept in memory
