# .env — settings for Agent Reels. Copy to .env and fill in. Lines starting with # are notes.
# After changing this file: pm2 restart generator --update-env

# ---- Required ----
PUBLIC_URL=https://yourdomain.com          # your site's public https address (no trailing slash)
PRODUCT_NAME=Agent Reels
OPENAI_API_KEY=
PIXABAY_API_KEY=
# PORT=3100
# HOST=127.0.0.1
# MONTHLY_VIDEOS=200                       # most videos a workspace makes in a month (Admin can set one workspace's own)

# ---- AI models (SETUP.md section X) ----
# OpenAI is removing older models: speech (gpt-4o-mini-tts, tts-1) on 2027-01-06, gpt-4o / gpt-4o-mini /
# gpt-4.1 on 2027-01-14, whisper-1 on 2027-02-26. Each job steps down its ladder by itself when one is
# retired, but set a backup company now. See every job's ladder with: node admin.js models
# OPENAI_MODEL=                            # writes scripts and post text (default gpt-4o)
# OPENAI_HOOK_MODEL=                       # writes the openings (default: OPENAI_MODEL)
# OPENAI_CRITIC_MODEL=                     # ranks openings and drafts; best as a different model (default: OPENAI_MODEL)
# OPENAI_QUICK_MODEL=
# OPENAI_COACH_MODEL=
# OPENAI_VISION_MODEL=                     # the clip check
# OPENAI_TTS_MODEL=
# OPENAI_TRANSCRIBE_MODEL=whisper-1        # word timings for single-take cuts and captions (must support word timestamps)
# OPENAI_STRUCTURED=on                     # exact reply shapes (structured outputs); off for providers that don't support them
# ANTHROPIC_API_KEY=                       # Claude: for writing, the coach and footage checks (first choice with AI_LADDER_*)
# ELEVENLABS_API_KEY=                      # ElevenLabs voices (also times its own words). Needed before 2027-01-06 for voiceovers.
# ELEVENLABS_VOICE_ID=                     # the ElevenLabs voice to use (from your ElevenLabs voice library)
# ELEVENLABS_VOICES={"coral":"<voice id>"} # optional: one ElevenLabs voice for each Brand voice
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_PRICE_PER_1K_CHARS=0.30       # for the cost meter: what your ElevenLabs plan charges
# A whole ladder for one job (first choice first; "anthropic:" or "elevenlabs:" for the other companies).
# Jobs: WRITER HOOKS CRITIC COACH QUICK VISION VOICE TIMING.
# AI_LADDER_WRITER=anthropic:claude-sonnet-5-5,gpt-6-luna
# AI_LADDER_VOICE=elevenlabs:eleven_multilingual_v2,gpt-4o-mini-tts
# OVERNIGHT_DRAFTS=1                       # drafts per overnight video (1-3); videos made by hand use the agent's setting
# VOICE_TAKE=single                        # single = one recording per video, cut into scenes (default); scene = one per scene
# OPENAI_TIMEOUT_MS=90000                  # how long to wait for one OpenAI answer
AI_COST_CAP_USD=20                         # monthly AI cost cap per workspace (USD); 0 = no cap. Alert at 80%, paused at 100%.
# COACH_PER_DAY=60                         # coach answers per workspace per day
# SCRIPT_TESTS_PER_DAY=                    # test scripts per workspace per day

# ---- Footage ----
# PEXELS_API_KEY=                          # free at pexels.com/api: a second stock source, mixed with Pixabay
# SHARED_CLIP_DAYS=120                     # a stock clip any agent used this recently is avoided for the others; 0 = off
# LIBRARY_MAX_CLIPS=40                     # agents' own clips, per workspace
# CLIP_UPLOAD_MAX_MB=200                   # largest clip upload; nginx client_max_body_size must allow it

# ---- Terms of Service and Privacy Policy (optional; SETUP.md section K) ----
# Both links set = agents must accept before using the app. Change TERMS_VERSION to ask everyone again.
TERMS_URL=
PRIVACY_URL=
TERMS_VERSION=1

# ---- Two-factor login and sessions (optional; SETUP.md section O) ----
# TWO_FACTOR=admins                        # admins (default) | all | off
# APP_KEY=                                 # encrypts 2FA keys; empty = a random key in .app-key (keep a copy of it)
# APP_KEY_OLD=                             # earlier keys, comma-separated, so what they sealed still opens (node admin.js rotate-key)
# AUDIT_KEEP_MONTHS=24                     # how long the activity log is kept
# ADMIN_SESSION_DAYS=7                     # admins log in again after this many days
# SESSION_IDLE_DAYS=14                     # any session ends after this many days unused

# ---- Off-site encrypted backups (optional but recommended; SETUP.md section Q) ----
# BACKUP_KEY: openssl rand -hex 32. Save it in your password manager: without it nobody can read the backups.
BACKUP_KEY=
BACKUP_S3_ENDPOINT=                        # e.g. https://s3.us-west-004.backblazeb2.com
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=                          # e.g. us-west-004 (Cloudflare R2: auto)
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=agent-reels/
# BACKUP_S3_KEEP_DAYS=30

# ---- Data deletion page (SETUP.md section M) ----
# Shown on /data-deletion as where to write when someone can't log in.
SUPPORT_EMAIL=

# ---- Alerts on your phone (optional; SETUP.md section E) ----
# An ntfy.sh topic (free app), or a Slack / Discord webhook URL.
ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_FORMAT=                    # text | slack | discord | json (picked automatically)
LOW_DISK_GB=3
# HEALTH_TOKEN=                            # openssl rand -hex 16; /api/health?token=… shows details (SETUP.md section R)
# BACKUP_LATE_HOURS=36                     # alert and fail the health check when the backup is this late
# JOB_STUCK_MINUTES=30                     # a video rendering longer than this counts as stuck
# ERROR_BURST=5                            # this many unexpected errors in 10 minutes sends an alert

# ---- Instagram auto-posting (optional; SETUP.md section F) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TOKEN_KEY=                                 # openssl rand -hex 32  (never change it once agents connect)
# INSTAGRAM_API_VERSION=v25.0
# INSTAGRAM_INSIGHTS=1                     # fill in views/reach automatically (needs the insights permission)
# INSTAGRAM_REPLIES=1                      # keyword replies to comments and messages (needs the messages permissions)
# INSTAGRAM_WEBHOOK_TOKEN=                 # the verify token you typed in Meta app → Instagram → Webhooks

# ---- Facebook Page cross-posting (optional; SETUP.md section AC) ----
# FACEBOOK_APP_ID=                         # the Meta app's App ID (Facebook Login for Business)
# FACEBOOK_APP_SECRET=
# FACEBOOK_API_VERSION=v25.0

# ---- Phone notifications (Web Push) ----
# The server makes and keeps its own key pair in data/ the first time it's needed. Set these (base64url)
# only to keep the same key across servers.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ---- Clean-up (days) ----
# KEEP_REJECTED_DAYS=14
# KEEP_PENDING_DAYS=30
# KEEP_VIDEO_FILES_DAYS=90
# KEEP_ASSETS_DAYS=30
# KEEP_BACKUPS=14

# ---- The engine (leave alone unless something needs it) ----
# OUTAGE_WAIT_MIN=10                       # a video whose AI or footage service is down waits this long and tries again (up to 6 times)
# JOB_IDLE_MINUTES=12                      # a video with no progress for this long is stopped and tried again
# JOB_MAX_MINUTES=40                       # no video runs longer than this
# RENDER_TIMEOUT_MIN=                      # the render's own limit (default: 10 seconds per second of video, at least 5 minutes)
# STAY_ON_JSON=1                           # keep using JSON files (the SQLite database is the standard)
# DISK_RESERVE_GB=1.5                      # below this much free space, no new video starts
# WORKER_JOBS=1                            # videos made at once (renders use every CPU)
# LEASE_SECONDS=90                         # a video that stops reporting progress this long goes back in line
# BREAKER_FAILURES=5                       # failures in a row that open a service's breaker
# BREAKER_COOL_SECONDS=60                  # how long it stays open before one trial call (doubles each time, up to 15 minutes)
# LIMP_AFTER_TRIES=3                       # tries the voice (or footage) service may fail before a video is made without it
# FONT_SOURCE_URL=                         # where a missing font is fetched (default: Google Fonts at the tested version)
# VIDEO_CACHE_FILES=300                    # how many video lists are kept in memory
# FAULTS_ALLOWED=0                         # 1 only on a spare server, to rehearse the crash and fault tests there
